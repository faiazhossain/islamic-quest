# Amal Quest optional cloud sync. Every variable is optional; without
# them the app runs fully local-first (offline, no account).

# openssl rand -base64 32
AUTH_SECRET=

# Pin the canonical origin in production (e.g. https://amalyn.app). auth.ts
# runs with trustHost, so without AUTH_URL the Host header is trusted when
# NextAuth builds sign-in callback URLs; behind an unmanaged proxy an
# attacker-controlled Host could point magic links at their own machine.
AUTH_URL=

# Google OAuth (Google Cloud Console -> Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Magic-link email via Resend: NOT wired yet. The email provider requires a
# database adapter in src/auth.ts (verification tokens + users), and setting
# these variables today does nothing. Leave empty until that lands.
# AUTH_RESEND_KEY=
# EMAIL_FROM="Amal Quest <hello@yourdomain.com>"

# Postgres (e.g. Neon). Apply the schema with: npm run db:push
DATABASE_URL=

# Staging only. Publishes the catalog before scholar review completes and
# lets the production build pass the launch tripwire. Unreviewed dhikr are
# still labeled "scholar review pending" in the UI. Never set this on a
# production deployment.
NEXT_PUBLIC_ALLOW_UNREVIEWED=
